# Public, non-secret configuration. Contract addresses and ABIs come from the
# synchronized official deployment manifest in deployments/ and abis/.
NEXT_PUBLIC_APP_NAME=CeloHT
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://app.celoht.com/
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_CELO_NETWORK=celoSepolia
NEXT_PUBLIC_CELO_CHAIN_ID=11142220
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CELO_EXPLORER_URL=https://celo-sepolia.blockscout.com
NEXT_PUBLIC_CELOSCAN_API_URL=https://api-sepolia.celoscan.io/api
NEXT_PUBLIC_CELO_SEPOLIA_CELOSCAN_API_URL=https://api-sepolia.celoscan.io/api

# Public Reown/WalletConnect Cloud project identifier. Create one at cloud.reown.com.
# Leave blank to disable QR/mobile WalletConnect and Valora connections explicitly.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Supported alias; if both variables are set, they must contain the same ID.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Backend-dependent features remain unavailable when these are blank.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BACKEND_URL=https://api.celoht.com

# Notification preferences and history are stored in browser localStorage;
# the official backend does not expose notification endpoints.

# Public display/configuration values only; never put signer credentials here.
NEXT_PUBLIC_USDM_ADDRESS=
NEXT_PUBLIC_CELOHT_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_CELOHT_SERVICE_PAYMENTS_ADDRESS=
NEXT_PUBLIC_CELOHT_EDUCATION_ADDRESS=
NEXT_PUBLIC_CELOHT_REFORESTATION_ADDRESS=
NEXT_PUBLIC_CELOHT_GOVERNANCE_ADDRESS=
NEXT_PUBLIC_CELOHT_TREASURY_SAFE=

COMMUNITY_GITHUB_URL=https://github.com/Celo-HaiTi
COMMUNITY_DISCORD_URL=https://discord.gg/Xcx6c9bBD2
COMMUNITY_TELEGRAM_URL=https://t.me/celoht_celoht_haiti
COMMUNITY_LINKEDIN_URL=https://www.linkedin.com/company/celoht/
