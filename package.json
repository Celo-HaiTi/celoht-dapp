{
  "name": "@celoht/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart contracts for the CeloHT dApp: agent registry, certificates, donations, and reforestation impact tracking on Celo.",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
