{
  "name": "celoht-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "CeloHT investor demo dApp: education, agent network, wallet simulation, and reforestation on Celo.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:github-pages": "GITHUB_PAGES=true REPO_NAME=celoht-dapp NEXT_PUBLIC_APP_URL=https://celo-haiti.github.io/celoht-dapp/ npm run build",
    "build:custom-domain": "GITHUB_PAGES=false NEXT_PUBLIC_APP_URL=https://app.celoht.com/ npm run build",
    "export": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "contracts:sync": "node scripts/sync-contracts.mjs --check",
    "contracts:sync-abis": "node scripts/sync-contracts.mjs",
    "test": "node --test tests/contracts-sync.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.11",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.21.54",
    "wagmi": "^2.14.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
